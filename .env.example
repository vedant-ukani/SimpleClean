# Runtime mode: development, test, staging, or production.
NODE_ENV=development

# Local development and tests default to pglite. Deployed environments use postgres.
DATABASE_DRIVER=pglite
# Required only when DATABASE_DRIVER=postgres. Never commit a real connection string.
DATABASE_URL=
# Gitignored location used by the local PGlite database.
PGLITE_DATA_DIR=.local-data/pglite
# Must be explicitly true to use PGlite in staging or production.
ALLOW_PGLITE_IN_DEPLOYED=false

API_PORT=3001
API_BASE_URL=http://localhost:3001
LOG_LEVEL=info

# Generate a unique value with: openssl rand -base64 32
# Required by the API. Never commit the generated value.
AUTH_SECRET=
# Public API origin used by Better Auth. Browser traffic is proxied through /api.
AUTH_BASE_URL=http://localhost:3001
# Browser origin allowed to submit credential/session requests.
AUTH_TRUSTED_ORIGIN=http://localhost:3000
# Eight-hour finite staff sessions.
AUTH_SESSION_DURATION_SECONDS=28800

# Dedicated QR HMAC secret. Generate independently with: openssl rand -base64 32
# Rotating it invalidates existing QR signatures and requires a planned label reissue.
QR_SIGNING_SECRET=
# Absolute browser origin used to construct /scan#<token> QR links.
PLATFORM_PUBLIC_ORIGIN=http://localhost:3000

# Private file storage. Local is for development/test and is not web-served.
FILE_STORAGE_DRIVER=local
FILE_LOCAL_DIRECTORY=.local-data/files
ALLOW_LOCAL_FILE_STORAGE_IN_DEPLOYED=false
# Required for S3-compatible storage; endpoint/path style are optional.
FILE_S3_BUCKET=
FILE_S3_REGION=
FILE_S3_ENDPOINT=
FILE_S3_FORCE_PATH_STYLE=false
# Omit both to use the AWS standard credential provider chain.
FILE_S3_ACCESS_KEY_ID=
FILE_S3_SECRET_ACCESS_KEY=
FILE_UPLOAD_GRANT_TTL_SECONDS=300
FILE_DOWNLOAD_GRANT_TTL_SECONDS=60
FILE_MAX_BYTES=15728640

# Transactional outbox worker. Tests disable polling and call the worker directly.
OPERATIONS_WORKER_MAX_ATTEMPTS=5
OPERATIONS_WORKER_LEASE_SECONDS=180
OPERATIONS_WORKER_POLL_MS=1000
OPERATIONS_WORKER_BACKOFF_BASE_MS=1000
OPERATIONS_WORKER_POLLING_ENABLED=true

# Intake recognition is disabled by default. When enabled, the active path is
# OpenAI field assignment after Google Vision OCR. Live evaluation requires an
# explicit --allow-live flag and never runs as part of npm test.
INTAKE_RECOGNITION_ENABLED=false
# The provider selections below take effect only when recognition is enabled.
INTAKE_RECOGNITION_SEMANTIC_PROVIDER=openai
INTAKE_RECOGNITION_SEMANTIC_MODEL=gpt-6-luna
INTAKE_RECOGNITION_SEMANTIC_ENDPOINT=
INTAKE_RECOGNITION_SEMANTIC_API_KEY=
INTAKE_RECOGNITION_VERIFIER_PROVIDER=google-vision
# Google Vision uses this endpoint/key pair; do not add credentials to
# source-controlled files.
INTAKE_RECOGNITION_VERIFIER_MODEL=document-text-detection
# The local PaddleOCR bridge uses http://127.0.0.1:8765/recognize only in
# local development; any deployed PaddleOCR fallback must use HTTPS.
# Google Vision pilot endpoint: https://vision.googleapis.com/v1/images:annotate
INTAKE_RECOGNITION_VERIFIER_ENDPOINT=
INTAKE_RECOGNITION_VERIFIER_API_KEY=
INTAKE_RECOGNITION_TIMEOUT_MS=60000
INTAKE_RECOGNITION_MAX_IMAGE_BYTES=8388608
INTAKE_RECOGNITION_MAX_BATCH_BYTES=41943040
# The live provider benchmark/pilot explicitly overrides this to 1000000 so
# both Google Vision and PaddleOCR receive the same bounded JPEG derivative.
INTAKE_RECOGNITION_MAX_PIXELS=20000000
INTAKE_RECOGNITION_MAX_OUTPUT_BYTES=2097152
INTAKE_RECOGNITION_POLICY_VERSION=intake-nameplate-policy-v4
# Omit policy floors to keep automatic acceptance disabled.
INTAKE_RECOGNITION_GROUP_FLOOR=
INTAKE_RECOGNITION_FIELD_FLOOR=
INTAKE_RECOGNITION_OCR_FLOOR=

# Catalog discovery is a separate, disabled-by-default provider call made only
# after accepted manufacturer/model identity exists. OpenAI web search remains
# unrestricted; deterministic policy accepts facts only from already trusted
# official manufacturer hostnames.
CATALOG_DISCOVERY_ENABLED=false
CATALOG_DISCOVERY_PROVIDER=disabled
CATALOG_DISCOVERY_MODEL=gpt-6-luna
CATALOG_DISCOVERY_ENDPOINT=
# Optional. When blank, the Intake OpenAI key above is reused.
CATALOG_DISCOVERY_API_KEY=
CATALOG_DISCOVERY_TIMEOUT_MS=60000
CATALOG_DISCOVERY_MAX_OUTPUT_BYTES=1048576
CATALOG_DISCOVERY_PROMPT_VERSION=catalog-discovery-prompt-v2
CATALOG_DISCOVERY_SCHEMA_VERSION=catalog-discovery-schema-v1
CATALOG_DISCOVERY_POLICY_VERSION=automatic-official-source-policy-v2
CATALOG_DISCOVERY_PRICING_VERSION=openai-gpt-6-luna-standard-2026-09-23
CATALOG_DISCOVERY_INPUT_USD_PER_MILLION_TOKENS=0.10
CATALOG_DISCOVERY_OUTPUT_USD_PER_MILLION_TOKENS=0.50
CATALOG_DISCOVERY_WEB_SEARCH_USD_PER_CALL=0.01

# Used only by `npm run auth:provision`. The password has no default and is
# passed through the environment, never a command-line argument.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_NAME=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_ROLE=owner_admin
