{
  "name": "@simply-clean/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "auth:provision": "tsx src/auth-provision.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run test/health.service.test.ts",
    "test:integration": "vitest run test/health.integration.test.ts test/identity.integration.test.ts test/inventory.integration.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@simply-clean/config": "*",
    "@simply-clean/contracts": "*",
    "@simply-clean/database": "*",
    "better-auth": "^1.7.5",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@simply-clean/test-support": "*",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4"
  }
}
